[debug] [2025-12-16T17:03:10.312Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/eyalamrami-1d69e/rulesets {"name":"projects/eyalamrami-1d69e/rulesets/c5ccf4a3-bb65-41c2-a196-dc3105a6ee4e","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n\n  match /databases/{database}/documents {\n\n    // ========== HELPER FUNCTIONS ==========\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isAdmin() {\n      return isSignedIn() &&\n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\n    }\n\n    function isVIP() {\n      return isSignedIn() &&\n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'vip';\n    }\n\n    function isPremium() {\n      return isSignedIn() &&\n             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'premium' ||\n              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'vip');\n    }\n\n    // ========== USERS COLLECTION ==========\n\n    match /users/{userId} {\n      // Users can read and write their own data\n      allow read: if isSignedIn() && request.auth.uid == userId;\n      allow write: if isSignedIn() && request.auth.uid == userId;\n      // Admins can read all users\n      allow read: if isAdmin();\n    }\n\n    // ========== ALERTS COLLECTION ==========\n\n    match /alerts/{alertId} {\n      // Everyone can read active alerts (public)\n      allow read: if resource.data.isActive == true;\n      // Admins can read all (including inactive)\n      allow read: if isAdmin();\n      // Only admins can create, update, delete\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== COURSES COLLECTION ==========\n\n    match /courses/{courseId} {\n      // Free users can only see free courses\n      // Premium/VIP users can see all courses\n      allow read: if isSignedIn() &&\n        (!resource.data.isPremium || isPremium());\n      // Only admins can modify courses\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== HOME CARDS COLLECTION ==========\n\n    match /homeCards/{cardId} {\n      // Public read for all\n      allow read: if true;\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== APP CONFIG COLLECTION ==========\n\n    match /appConfig/config {\n      // Public read\n      allow read: if true;\n      // Only admins can modify\n      allow write: if isAdmin();\n    }\n\n    // ========== RECOMMENDATIONS COLLECTION ==========\n\n    match /recommendations/{recoId} {\n      // All signed-in users can read\n      allow read: if isSignedIn();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== NEWS COLLECTION ==========\n\n    match /news/{newsId} {\n      // Published news can be read by everyone (public)\n      allow read: if resource.data.isPublished == true;\n      // Admins can read all (including drafts)\n      allow read: if isAdmin();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== MARKET DATA COLLECTION ==========\n\n    match /marketData/snapshot {\n      // Public read for market data\n      allow read: if true;\n      // Only server/admin can write\n      allow write: if isAdmin();\n    }\n\n    // ========== LESSONS COLLECTION ==========\n\n    match /lessons/{lessonId} {\n      // All signed-in users can read lessons\n      allow read: if isSignedIn();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== PODCASTS COLLECTION ==========\n\n    match /podcasts/{podcastId} {\n      // Everyone can read active podcasts (public)\n      allow read: if resource.data.isActive == true;\n      // Admins can read all (including inactive)\n      allow read: if isAdmin();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== DAILY VIDEOS COLLECTION ==========\n\n    match /dailyVideos/{videoId} {\n      // Everyone can read active videos (public)\n      // Default to true if isActive field is missing (backward compatibility)\n      allow read: if resource.data.isActive != false;\n      // Admins can read all (including inactive)\n      allow read: if isAdmin();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== INSTITUTIONS COLLECTION ==========\n\n    match /institutions/{institutionId} {\n      // Public read for all\n      allow read: if true;\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== LEADS COLLECTION ==========\n\n    match /leads/{leadId} {\n      // Anyone can create a lead (for contact forms)\n      allow create: if true;\n      // Only admins can read leads\n      allow read: if isAdmin();\n      // Only admins can update/delete leads\n      allow update, delete: if isAdmin();\n    }\n\n    // ========== COMMUNITY POSTS COLLECTION ==========\n\n    match /communityPosts/{postId} {\n      // Everyone can read active community posts (public)\n      allow read: if resource.data.isActive == true;\n      // Admins can read all (including inactive)\n      allow read: if isAdmin();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== BOOKS COLLECTION ==========\n\n    match /books/{bookId} {\n      // Public read for all books (like lessons)\n      allow read: if true;\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== FLYERS COLLECTION ==========\n\n    match /flyers/{flyerId} {\n      // Everyone can read active flyers (public)\n      // Default to true if isActive field is missing (backward compatibility)\n      allow read: if resource.data.isActive != false;\n      // Admins can read all (including inactive)\n      allow read: if isAdmin();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== INSTITUTIONS CONTENT COLLECTION ==========\n\n    match /institutionsContent/{activityId} {\n      // All signed-in users can read institution content\n      allow read: if isSignedIn();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== FAITH STORIES COLLECTION ==========\n\n    match /faith_stories/{storyId} {\n      // Admins can read all stories\n      allow read: if isAdmin();\n      // Signed-in users can read the collection (for queries)\n      // Filtering by isActive will be done in the query\n      allow read: if isSignedIn();\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== WEEKLY LESSONS COLLECTION ==========\n    match /weeklyLessons/{lessonId} {\n      // Public read for all weekly lessons\n      allow read: if true;\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== DAILY INSIGHT COLLECTION ==========\n    match /dailyInsight/{docId} {\n      // Public read for all daily insight content\n      allow read: if true;\n      // Only admins can modify\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ========== FAITH TOPICS COLLECTION ==========\n    match /faith_topics/{topicId} {\n      // Public read for all faith topics\n      allow read: if true;\n      // Allow initial creation if collection is empty (for seeding)\n      // Then only admins can modify\n      allow create: if true;\n      allow update, delete: if isAdmin();\n    }\n    \n    // ========== DEFAULT DENY ==========\n    \n    // Deny all other requests\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n  }\n\n}\n\n\n","name":"firestore.rules"}]},"createTime":"2025-12-16T17:03:10.286111Z","metadata":{"services":["cloud.firestore"]}}
